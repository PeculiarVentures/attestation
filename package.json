{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "mocha",
    "cli": "ts-node -r tsconfig-paths/register packages/cli/src/main.ts",
    "lint": "eslint eslint.config.mjs packages/*/src/**/*.ts",
    "lint:fix": "eslint --fix eslint.config.mjs packages/*/src/**/*.ts",
    "clean": "leran run clean",
    "build": "lerna run build",
    "coverage": "nyc mocha"
  },
  "dependencies": {
    "@peculiar/eslint-config-base": "^0.2.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/pako": "^2.0.3",
    "eslint": "^9.22.0",
    "lerna": "^8.2.1",
    "mocha": "^11.1.0",
    "nyc": "^17.1.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.1"
  }
}
