{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "cli": "tsx packages/cli/src/main.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "clean": "leran run clean",
    "build": "lerna run build",
    "coverage": "vitest run --coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@abraham/reflection": "^0.13.0",
    "@types/node": "^25.9.9",
    "@types/pako": "^2.0.4",
    "lerna": "^9.0.7",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5"
  }
}
