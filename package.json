{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "cli": "tsx packages/cli/src/main.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "clean": "rimraf packages/*/build packages/cli/bin",
    "build": "tsdown",
    "coverage": "vitest run --coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test:package": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@abraham/reflection": "^0.13.0",
    "@types/node": "^25.9.9",
    "@types/pako": "^2.0.4",
    "lerna": "^9.0.7",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsdown": "^0.23.1",
    "@arethetypeswrong/core": "^0.18.5"
  },
  "type": "module",
  "allowScripts": {
    "pkcs11js@2.1.6": true
  },
  "version": "2.0.0"
}
