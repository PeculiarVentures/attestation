{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "jest",
    "cli": "tsx packages/cli/src/main.ts",
    "lint": "eslint eslint.config.mjs packages/*/src/**/*.ts",
    "lint:fix": "eslint --fix eslint.config.mjs packages/*/src/**/*.ts",
    "clean": "leran run clean",
    "build": "lerna run build",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@peculiar/eslint-config-base": "^0.2.9",
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@abraham/reflection": "^0.13.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.0",
    "@types/pako": "^2.0.4",
    "eslint": "^10.1.0",
    "lerna": "^9.0.7",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
