{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "jest",
    "cli": "tsx packages/cli/src/main.ts",
    "lint": "eslint eslint.config.mjs packages/*/src/**/*.ts",
    "lint:fix": "eslint --fix eslint.config.mjs packages/*/src/**/*.ts",
    "clean": "leran run clean",
    "build": "lerna run build",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@peculiar/eslint-config-base": "^0.2.1",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/pako": "^2.0.3",
    "eslint": "^9.22.0",
    "lerna": "^8.2.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.1"
  }
}