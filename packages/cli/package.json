  "description": "A CLI utility for verifying attestation data in various formats, supporting multiple attestation providers and offering a range of commands to interact with attestation files and certificates.",
  "homepage": "https://github.com/PeculiarVentures/attestation/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/PeculiarVentures/attestation/issues"
  },
  "bin": {
    "attest": "./bin/main.js"
  },
  "main": "./bin/main.js",
  "files": [
    "bin",
    "build",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@abraham/reflection": "^0.13.0",
    "@peculiar/attestation-marvell": "^2.0.0",
    "@peculiar/attestation-yubico": "^2.0.0",
    "@peculiar/x509": "^2.0.0",
    "commander": "^14.0.3",
    "tslib": "^2.8.1"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "npm run clean && tsc -p tsconfig.build.json"
