  "description": "A library providing tools to verify HSM attestation files from various HSMs that support Marvell attestation, including support for certificate chain validation and attestation data extraction.",
  "homepage": "https://github.com/PeculiarVentures/attestation/tree/main/packages/marvell#readme",
  "bugs": {
    "url": "https://github.com/PeculiarVentures/attestation/issues"
  },
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@peculiar/asn1-rsa": "^2.11.1",
    "@peculiar/asn1-schema": "^2.11.1",
    "@peculiar/asn1-x509": "^2.11.1",
    "@peculiar/attestation-common": "^2.0.0",
    "@peculiar/x509": "^2.2.0",
    "pako": "^2.2.0",
    "pvtsutils": "^1.3.6",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0"
  },
  "keywords": [
    "marvell",
    "attestation",
    "hsm"
  ],
