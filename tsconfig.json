{
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@peculiar/attestation-*": ["./packages/*/src"]
    },
    "isolatedDeclarations": true,
    "declaration": true
  },
  "include": ["packages/*/src"]
}
