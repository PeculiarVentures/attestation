{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noErrorTruncation": true,
    "noEmit": true,
    "paths": {
      "@peculiar/attestation-*": ["./packages/*/src"]
    }
  },
  "include": ["packages/*/src", "*.config.ts"]
}
